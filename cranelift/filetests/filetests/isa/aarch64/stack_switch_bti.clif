test compile precise-output
set opt_level=speed
set stack_switch_model=basic
target aarch64 use_bti

;; A resumed stack is an indirect jump target and therefore needs a BTI landing
;; pad when forward-edge control-flow integrity is enabled.
function %switch_bti(i64, i64, i64) -> i64 {
block0(v0: i64, v1: i64, v2: i64):
  v3 = stack_switch v0, v1, v2
  return v3
}

