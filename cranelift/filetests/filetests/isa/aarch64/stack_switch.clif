;   ldp x25, x26, [sp], #0x10
;   ldp x27, x28, [sp], #0x10
;   ldp x29, x30, [sp], #0x10
;   ret

;; Test that a floating-point value live across a stack switch is spilled.
function %switch_float_clobber(i64, i64) -> f64 {
block0(v0: i64, v1: i64):
  v2 = iconst.i64 0
  v3 = load.f64 v0
  v4 = stack_switch v1, v1, v2
  v5 = fcvt_from_uint.f64 v4
  v6 = fadd v5, v3
  return v6
}

