;   stp d10, d11, [sp, #-0x10]!
;   stp d8, d9, [sp, #-0x10]!
;   sub sp, sp, #0x10
; block1: ; offset 0x30
;   ldr x7, [x0] ; trap: heap_oob
;   stur x7, [sp]
;   mov x0, #0
;   ldp x16, x17, [x1]
